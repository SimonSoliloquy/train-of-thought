{
  // Train of Thought at https://simonsoliloquy.com/train-of-thought/: plain files on Cloudflare (free and unlimited: no
  // Worker code runs). tools/cf-build.sh builds them into .cf/train-of-thought/, because the URL path is the
  // folder path. The routes claim that one path on the simonsoliloquy.com site.
  "name": "train-of-thought",
  "compatibility_date": "2026-11-01",
  "account_id": "27acccc64187a6a9c27103eadb2eb10f",
  "workers_dev": false,
  "assets": { "directory": "./.cf" },
  "routes": [
    { "pattern": "simonsoliloquy.com/train-of-thought", "zone_name": "simonsoliloquy.com" },
    { "pattern": "simonsoliloquy.com/train-of-thought/*", "zone_name": "simonsoliloquy.com" }
  ]
}
